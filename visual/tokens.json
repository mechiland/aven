{
  "name": "Aven Mist",
  "version": 1,
  "status": "booted round4 focused prototype passed independent review",
  "units": "logical pixels at 96 DPI; font sizes in points",
  "typography": {
    "ui": {
      "family": "Noto Sans",
      "sizePt": 11,
      "weight": 400
    },
    "small": {
      "family": "Noto Sans",
      "sizePt": 10,
      "weight": 400
    },
    "title": {
      "family": "Noto Sans",
      "sizePt": 11,
      "weight": 500
    },
    "reading": {
      "family": "Noto Sans",
      "sizePx": 16,
      "lineHeight": 1.65
    },
    "readingChinese": {
      "sizePx": 17,
      "lineHeight": 1.75
    },
    "note": "Font fallback, fontconfig and Chinese regional glyph rules are owned by the typography profile. Never apply Latin letter-spacing to CJK. Application font metrics determine native row heights."
  },
  "spacing": {
    "micro": 4,
    "tight": 8,
    "related": 12,
    "standard": 16,
    "section": 24,
    "page": 32
  },
  "control": {
    "minimumHeight": 32,
    "comfortableHeight": 36,
    "rowHeightTarget": 36,
    "titleHeight": 38
  },
  "radius": {
    "small": 4,
    "control": 6,
    "surface": 10,
    "preview": 12
  },
  "surface": {
    "content": "#FDFCF9",
    "alternate": "#F7F7F3",
    "chrome": "#F1F3EF",
    "chromeInactive": "#F5F5F1",
    "raised": "#FFFFFF",
    "hover": "#E5ECE6",
    "selection": "#326B60",
    "selectionInactive": "#DCE8E0",
    "complementary": "#243B35"
  },
  "foreground": {
    "primary": "#26342F",
    "secondary": "#65706A",
    "selected": "#FFFFFF",
    "negative": "#AD433E",
    "positive": "#286646",
    "neutral": "#865B1D"
  },
  "border": {
    "color": "#D7DDD5",
    "width": 1,
    "focus": "#326B60"
  },
  "shadow": {
    "color": "#18312A",
    "activeOpacity": 0.16,
    "inactiveOpacity": 0.08,
    "spread": 0,
    "blurTarget": 24,
    "offsetYTarget": 6
  },
  "accent": {
    "primary": "#326B60",
    "hover": "#3F7C70",
    "pressed": "#28564D",
    "soft": "#DCE8E0"
  },
  "icon": {
    "toolbar": 22,
    "sidebar": 22,
    "list": 22,
    "grid": 48,
    "filePreviewGrid": 96,
    "photoGrid": 240,
    "decorationGlyph": 12
  },
  "window": {
    "buttons": "minimize,maximize,close",
    "buttonSide": "right",
    "titleAlignment": "left",
    "borderWidth": 1,
    "translucentTitlebar": false
  },
  "motion": {
    "feedbackMs": 100,
    "menuMs": 120,
    "windowMs": 160,
    "previewMs": 140,
    "imageMs": 120,
    "overviewMs": 180,
    "easing": "ease-out",
    "reducedMotion": "disable animation; preserve immediate state feedback"
  },
  "implementation": {
    "nativeQtStyle": "Breeze",
    "colorScheme": "AvenMist",
    "iconTheme": "Aven",
    "windowDecorationCandidate": "__aurorae__svg__Aven",
    "wallpaper": "AvenEstuary",
    "limits": "Tokens are targets, not a claim that Breeze exposes every metric. Do not inject global QSS into native apps. Stock native control geometry is retained wherever no public per-app setting exists."
  }
}
