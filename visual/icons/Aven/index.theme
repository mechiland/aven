[Icon Theme]
Name=Aven
Comment=Focused Aven folder icons; all remaining icons inherit Breeze.
Inherits=breeze,hicolor
Directories=scalable/places,scalable/apps,scalable/mimetypes

[scalable/places]
Size=64
MinSize=16
MaxSize=256
Context=Places
Type=Scalable

[scalable/apps]
Size=64
MinSize=16
MaxSize=256
Context=Applications
Type=Scalable

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=256
Context=MimeTypes
Type=Scalable
